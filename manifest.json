{
  "manifest_version": 3,
  "name": "LeetCode Buddy",
  "version": "1.0",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "description": "Helps make your leetcode a better journey",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "index.html",
    "run_at": "document_end"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ]
}
